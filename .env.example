# Astro build flags: remain false until installation AND controller approval.
MATOMO_ENABLED=false
MATOMO_PRIVACY_APPROVED=false
PUBLIC_MATOMO_URL=
PUBLIC_MATOMO_SITE_ID=
# The variables below belong ONLY to protected Matomo server configuration.
# Never use PUBLIC_ prefixes or place real values in this repository.
MATOMO_DB_HOST=
MATOMO_DB_PORT=
MATOMO_DB_NAME=
MATOMO_DB_USER=
MATOMO_DB_PASSWORD=
MATOMO_DB_CA_FILE=
