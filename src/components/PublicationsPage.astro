---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalizedCollection } from '../lib/content-data';
import { research, years, sourceUrl, workNames } from '../lib/research';
import type { Locale } from '../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const it = locale === 'it';
const selected = getLocalizedCollection('papers', locale);
---

<BaseLayout
  locale={locale}
  title={it ? 'Pubblicazioni | Federico Cerutti' : 'Papers | Federico Cerutti'}
  description="AI, cybersecurity, uncertainty and argumentation."
  alternatePath={it ? '/en/research/' : '/it/ricerca/'}
>
  <section class="page-intro">
    <div class="container">
      <h1>{it ? 'Pubblicazioni' : 'Papers'}</h1>
    </div>
  </section>
  <section class="section">
    <div class="container stack">
      {years.map((year) => (
        <section class="bibliography-year stack">
          <h2>{year}</h2>
          <ol class="publications">
            {research.works
              .filter((w) => w.year === year)
              .sort((a, b) => a.title.localeCompare(b.title))
              .map((w) => (
                <li class="publication">
                  <h3>
                    <a data-analytics-event="publication-link" href={sourceUrl(w)}>
                      {w.title}
                    </a>
                  </h3>
                  <p class="small muted">{it ? 'Con ' : 'With '}{workNames(w).join(', ')}</p>
                  <p class="small muted">{w.venue}</p>
                </li>
              ))}
          </ol>
        </section>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Rapporti tecnici e altri contributi' : 'Technical reports and other outputs'}</h2>
      <ol class="publications">
        {[...research.daisReports]
          .sort((a, b) => b.year - a.year)
          .map((d) => (
            <li class="publication">
              <h3>
                <a href={d.url}>{d.title}</a>
              </h3>
              <p class="small muted">
                {d.authorNames.join(', ')} · {d.year}
              </p>
            </li>
          ))}
      </ol>
    </div>
  </section>
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Approfondimenti' : 'Research summaries'}</h2>
      {selected.map((p) => (
        <article class="stack">
          <h3>
            <a href={`${it ? '/ricerca/' : '/en/research/'}${p.pathSlug}/`}>{p.title}</a>
          </h3>
          <p>{p.summary}</p>
        </article>
      ))}
    </div>
  </section>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(
      research.works.map((w) => ({
        '@context': 'https://schema.org',
        '@type': 'ScholarlyArticle',
        headline: w.title,
        datePublished: String(w.year),
        url: sourceUrl(w),
        ...(w.doi ? { identifier: w.doi } : {}),
        author: [
          { '@type': 'Person', name: 'Federico Cerutti' },
          ...workNames(w).map((name) => ({ '@type': 'Person', name })),
        ],
      })),
    ).replace(/</g, '\\u003c')}
  />
</BaseLayout>
