---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from './ContentCard.astro';
import {
  collaborations,
  collaborationCopy,
  collaborationPath,
  organisationName,
} from '../lib/portfolio';
import type { Locale } from '../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const it = locale === 'it';
const groups = [
  { title: it ? 'Aziende' : 'Companies', sectors: ['Industry'] },
  {
    title: it ? 'Istituzioni e centri di ricerca' : 'Institutions and research centres',
    sectors: ['Government / defence', 'Public research', 'Public organisation'],
  },
  { title: it ? 'Università' : 'Universities', sectors: ['Academic'] },
];
---

<BaseLayout
  locale={locale}
  title={it ? 'Collaborazioni | Federico Cerutti' : 'Collaborations | Federico Cerutti'}
  description={
    it
      ? 'Collaborazioni con aziende, istituzioni e università.'
      : 'Collaborations with companies, institutions and universities.'
  }
  alternatePath={it ? '/en/research-network/' : '/it/rete-di-ricerca/'}
>
  <section class="page-intro">
    <div class="container stack">
      <h1>{it ? 'Collaborazioni' : 'Collaborations'}</h1>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {groups.map((group) => (
        <section class="collaboration-group stack">
          <h2>{group.title}</h2>
          <div class="portfolio-list">
            {collaborations
              .filter((o) => group.sectors.includes(o.sector))
              .map((o) => (
                <ContentCard
                  id={o.id}
                  title={organisationName(o.name)}
                  href={collaborationPath(o.id, locale)}
                  summary={collaborationCopy(o, locale).description}
                  plain
                />
              ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
