---
import BaseLayout from '../layouts/BaseLayout.astro';
import { collaborations, worksById, collaborationCopy } from '../lib/portfolio';
import { research, sourceUrl } from '../lib/research';
import type { Locale } from '../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const it = locale === 'it';
const groups = [
  { title: it ? 'Aziende' : 'Companies', sectors: ['Industry'] },
  {
    title: it ? 'Istituzioni e centri di ricerca' : 'Institutions and research centres',
    sectors: ['Government / defence', 'Public research', 'Public organisation'],
  },
  { title: it ? 'Università' : 'Universities', sectors: ['Academic'] },
];
---

<BaseLayout
  locale={locale}
  title={it ? 'Collaborazioni | Federico Cerutti' : 'Collaborations | Federico Cerutti'}
  description={
    it
      ? 'Collaborazioni con aziende, istituzioni e università.'
      : 'Collaborations with companies, institutions and universities.'
  }
  alternatePath={it ? '/en/research-network/' : '/it/rete-di-ricerca/'}
>
  <section class="page-intro">
    <div class="container stack">
      <h1>{it ? 'Collaborazioni' : 'Collaborations'}</h1>
      <p>
        {it
          ? 'Dall’industria ai laboratori pubblici e alle università: ricerca condivisa su AI, cybersecurity e decisioni. Apri un’organizzazione per leggere i lavori collegati.'
          : 'From industry to public laboratories and universities: shared research on AI, cybersecurity and decisions. Open an organisation to read the related work.'}
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {groups.map((group) => (
        <section class="collaboration-group stack">
          <h2>{group.title}</h2>
          <div class="collaboration-cards">
            {collaborations
              .filter((o) => group.sectors.includes(o.sector))
              .map((o) => {
                const affiliations = research.verifiedAffiliations.filter(
                  (a) => a.institutionId === o.id,
                );
                const works = o.workIds
                  .map((id) => worksById.get(id)!)
                  .filter(Boolean)
                  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
                const reports = research.daisReports.filter((d) =>
                  affiliations.some((a) => a.sourceUrl === d.url),
                );
                return (
                  <details id={o.id} class="collaboration-card">
                    <summary>
                      <h3>
                        {o.name
                          .replace(' (verified current)', '')
                          .replace(' (DAIS joint demonstration)', '')}
                      </h3>
                      <p class="organisation-introduction small muted">
                        {collaborationCopy(o, locale).identity}
                      </p>
                      <p class="collaboration-description">
                        {collaborationCopy(o, locale).description}
                      </p>
                      <span class="collaboration-action">
                        <span class="when-closed">
                          {it ? 'Vedi i lavori' : 'View related work'}
                        </span>
                        <span class="when-open">
                          {it ? 'Chiudi i lavori' : 'Close related work'}
                        </span>
                        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                          <path
                            d="m4 6 4 4 4-4"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.4"
                          />
                        </svg>
                      </span>
                    </summary>
                    <div class="stack">
                      <ul class="plain-links">
                        {works.map((w) => (
                          <li>
                            <a href={sourceUrl(w)}>{w.title}</a> ({w.year})
                          </li>
                        ))}
                        {reports.map((d) => (
                          <li>
                            <a href={d.url}>{d.title}</a> ({d.year})
                          </li>
                        ))}
                      </ul>
                      {o.sourceUrl && (
                        <p class="small">
                          <a href={o.sourceUrl}>
                            {it ? 'Sito dell’organizzazione' : 'Organisation website'}
                          </a>
                        </p>
                      )}
                    </div>
                  </details>
                );
              })}
          </div>
        </section>
      ))}
    </div>
  </section>
  <script>
    const openTarget = () => {
      const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (target instanceof HTMLDetailsElement) target.open = true;
    };
    openTarget();
    window.addEventListener('hashchange', openTarget);
  </script>
</BaseLayout>
