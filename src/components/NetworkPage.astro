---
import BaseLayout from '../layouts/BaseLayout.astro';
import { collaborations, peopleById, worksById } from '../lib/portfolio';
import { research, sourceUrl } from '../lib/research';
import type { Locale } from '../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const it = locale === 'it';
---

<BaseLayout
  locale={locale}
  title={it ? 'Collaborazioni | Federico Cerutti' : 'Collaborations | Federico Cerutti'}
  description={
    it
      ? 'Persone e organizzazioni con cui ho lavorato.'
      : 'People and organisations I have worked with.'
  }
  alternatePath={it ? '/en/research-network/' : '/it/rete-di-ricerca/'}
>
  <section class="page-intro">
    <div class="container stack">
      <h1>{it ? 'Collaborazioni' : 'Collaborations'}</h1>
      <p>
        {it
          ? 'Lavoro con ricercatori di aziende, università e istituzioni in diversi paesi. Qui trovi le persone e alcuni dei lavori che ci collegano.'
          : 'I work with researchers at companies, universities and institutions across different countries. Here are the people and the work we have done together.'}
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container collaborations-list">
      {collaborations.map((o) => {
        const affiliations = research.verifiedAffiliations.filter((a) => a.institutionId === o.id);
        const names = [
          ...new Set([
            ...o.collaboratorIds.map((id) => peopleById.get(id)?.name).filter(Boolean),
            ...affiliations.map((a) => a.researcherName),
          ]),
        ];
        const works = o.workIds
          .map((id) => worksById.get(id)!)
          .filter(Boolean)
          .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
        const reports = research.daisReports.filter((d) =>
          affiliations.some((a) => a.sourceUrl === d.url),
        );
        return (
          <article id={o.id} class="collaboration stack">
            <h2>{o.sourceUrl ? <a href={o.sourceUrl}>{o.name}</a> : o.name}</h2>
            <p>{names.join(', ')}</p>
            <ul class="plain-links">
              {works.map((w) => (
                <li>
                  <a href={sourceUrl(w)}>{w.title}</a> <span class="muted">({w.year})</span>
                </li>
              ))}
              {reports.map((d) => (
                <li>
                  <a href={d.url}>{d.title}</a> ({d.year})
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
