---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  collaborations,
  collaborationCopy,
  collaborationPath,
  organisationName,
} from '../lib/portfolio';
import type { Locale } from '../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const it = locale === 'it';
const groups = [
  { title: it ? 'Aziende' : 'Companies', sectors: ['Industry'] },
  {
    title: it ? 'Istituzioni e centri di ricerca' : 'Institutions and research centres',
    sectors: ['Government / defence', 'Public research', 'Public organisation'],
  },
  { title: it ? 'Università' : 'Universities', sectors: ['Academic'] },
];
---

<BaseLayout
  locale={locale}
  title={it ? 'Collaborazioni | Federico Cerutti' : 'Collaborations | Federico Cerutti'}
  description={
    it
      ? 'Collaborazioni con aziende, istituzioni e università.'
      : 'Collaborations with companies, institutions and universities.'
  }
  alternatePath={it ? '/en/research-network/' : '/it/rete-di-ricerca/'}
>
  <section class="page-intro">
    <div class="container stack">
      <h1>{it ? 'Collaborazioni' : 'Collaborations'}</h1>
      <p>
        {it
          ? 'Dall’industria ai laboratori pubblici e alle università: ricerca condivisa su AI, cybersecurity e decisioni. Visita la pagina di un’organizzazione per conoscere la collaborazione e leggere i lavori collegati.'
          : 'From industry to public laboratories and universities: shared research on AI, cybersecurity and decisions. Visit an organisation’s page to learn about the collaboration and read the related work.'}
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {groups.map((group) => (
        <section class="collaboration-group stack">
          <h2>{group.title}</h2>
          <div class="collaboration-cards">
            {collaborations
              .filter((o) => group.sectors.includes(o.sector))
              .map((o) => (
                <a
                  id={o.id}
                  class="collaboration-card collaboration-card-link stack"
                  href={collaborationPath(o.id, locale)}
                >
                  <h3>{organisationName(o.name)}</h3>
                  {o.sector !== 'Academic' && (
                    <p class="organisation-introduction small muted">
                      {collaborationCopy(o, locale).identity}
                    </p>
                  )}
                  <p class="collaboration-description">
                    {collaborationCopy(o, locale).description}
                  </p>
                  <span class="collaboration-action">
                    {it ? 'Scopri la collaborazione' : 'Explore the collaboration'}{' '}
                    <span aria-hidden="true">→</span>
                  </span>
                </a>
              ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
