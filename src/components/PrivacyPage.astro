---
import BaseLayout from '../layouts/BaseLayout.astro';
const { locale } = Astro.props;
const it = locale === 'it';
---

<BaseLayout
  locale={locale}
  title={it ? 'Privacy e statistiche | Federico Cerutti' : 'Privacy & analytics | Federico Cerutti'}
  description={
    it
      ? 'Informazioni sulla privacy dell’Università degli Studi di Brescia.'
      : 'University of Brescia privacy information.'
  }
  alternatePath={it ? '/en/privacy/' : '/it/privacy/'}
>
  <section class="page-intro">
    <div class="container">
      <h1>{it ? 'Privacy e statistiche' : 'Privacy & analytics'}</h1>
    </div>
  </section>
  <section class="section">
    <div class="container prose stack">
      <p>
        {it
          ? 'Per le informazioni sul trattamento dei dati personali consulta l’informativa dell’Università degli Studi di Brescia.'
          : 'For information about the processing of personal data, please consult the University of Brescia privacy policy.'}
      </p>
      <p>
        <a href="https://www.unibs.it/it/privacy-policy-university-portals">
          {it
            ? 'Informativa dell’Università degli Studi di Brescia'
            : 'University of Brescia privacy policy'}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
