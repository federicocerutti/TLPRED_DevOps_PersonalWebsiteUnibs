---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyIntroduction from './CompanyIntroduction.astro';
import ContactInvitation from './ContactInvitation.astro';
import type { Locale } from '../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const it = locale === 'it';
const services = it
  ? [
      [
        'Ricerca',
        'Studiare una domanda scientifica o tecnica sull’affidabilità dell’AI, sulla cybersecurity o sulle decisioni in condizioni di incertezza.',
      ],
      [
        'Consulenza tecnico-scientifica',
        'Valutare metodi e approcci, esaminare problemi tecnici e preparare pareri o relazioni per supportare le decisioni.',
      ],
      [
        'Formazione',
        'Preparare corsi, seminari e materiali didattici su misura per gruppi tecnici e responsabili delle decisioni.',
      ],
    ]
  : [
      [
        'Research',
        'Investigate a specific scientific or technical question concerning AI reliability, cybersecurity or decision-making under uncertainty.',
      ],
      [
        'Technical consultancy',
        'Assess methods and approaches, examine technical problems and prepare opinions or reports to support decisions.',
      ],
      [
        'Training',
        'Prepare tailored courses, seminars and teaching materials for technical teams and decision-makers.',
      ],
    ];
---

<BaseLayout
  locale={locale}
  title={it ? 'Consulenza | Federico Cerutti' : 'Advisory | Federico Cerutti'}
  description={
    it
      ? 'Ricerca, consulenza e formazione per aziende ed enti attraverso UniBS.'
      : 'Research, technical consultancy and training for companies through UniBS.'
  }
  alternatePath={it ? '/en/advisory/' : '/it/consulenza/'}
>
  <section class="page-intro">
    <div class="container stack">
      <h1>{it ? 'Ricerca, consulenza e formazione' : 'Research, consultancy and training'}</h1>
      <CompanyIntroduction locale={locale} />
      <p>
        {it
          ? 'Mi occupo di sicurezza dell’AI, cybersecurity, ragionamento sotto incertezza e collaborazione uomo–AI.'
          : 'My work concerns AI security, cybersecurity, reasoning under uncertainty and human–AI collaboration.'}
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container three-col">
      {services.map(([title, body]) => (
        <article class="stack">
          <h2>{title}</h2>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>
  <ContactInvitation locale={locale} />
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Informazioni UniBS' : 'UniBS information'}</h2>
      <ul class="plain-links">
        <li>
          <a href={`https://www.unibs.it/${it ? 'it' : 'en'}/enti-aziende/ricerca-commissionata`}>
            {it ? 'Ricerca commissionata' : 'Commissioned research'}
          </a>
        </li>
        <li>
          <a href="https://www.unibs.it/it/ateneo/amministrazione/statuto-e-regolamenti/regolamenti-ricerca">
            {it ? 'Regolamenti per la ricerca' : 'Research regulations (in Italian)'}
          </a>
        </li>
        <li>
          <a href="https://www.unibs.it/it/node/1536">
            {it ? 'Regolamento conto terzi' : 'Regulation for commissioned activities (in Italian)'}
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
