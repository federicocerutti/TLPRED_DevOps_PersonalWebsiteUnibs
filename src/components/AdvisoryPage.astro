---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyIntroduction from './CompanyIntroduction.astro';
import ContactInvitation from './ContactInvitation.astro';
import type { Locale } from '../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const it = locale === 'it';
const services = [
  [
    'Proteggere la conoscenza critica',
    'Protect critical knowledge',
    'Vuoi usare un assistente AI con documenti e competenze interne? Possiamo individuare quali conoscenze proteggere e come potrebbero essere esposte. Il lavoro può produrre una mappa delle conoscenze critiche, dei rischi e delle priorità di protezione.',
    'Introducing an AI assistant that uses internal documents and expertise? We can examine which knowledge needs protection and how it could be exposed. The work can produce a map of critical knowledge, exposure risks and protection priorities.',
  ],
  [
    'Valutare AI e rischi cyber',
    'Assess AI and cyber risks',
    'Devi valutare un sistema di AI o un fornitore prima dell’adozione? Possiamo esaminarne sicurezza, affidabilità e limiti. Il lavoro può produrre una valutazione tecnica con risultati, limiti dell’analisi e raccomandazioni ordinate per priorità.',
    'Evaluating an AI system or supplier before adoption? We can examine its security, reliability and limitations. The work can produce a technical assessment with findings, limits of the analysis and prioritised recommendations.',
  ],
  [
    'Rendere le decisioni ricostruibili',
    'Make decisions traceable',
    'Devi chiarire chi autorizza, verifica e riesamina le decisioni supportate dall’AI? Possiamo esaminare processi, responsabilità e documentazione. Il lavoro può produrre una revisione delle lacune e delle verifiche da definire per spiegare e riesaminare le scelte.',
    'Need to establish who authorises, checks and revisits AI-supported decisions? We can examine processes, responsibilities and documentation. The work can produce a review of gaps and checks to define so that decisions can be explained and revisited.',
  ],
  [
    'Formare chi decide e chi realizza',
    'Train decision-makers and technical teams',
    'Dirigenti o gruppi tecnici devono prendere decisioni sull’AI in azienda? Possiamo partire dalle loro domande e dai casi d’uso dell’organizzazione. Il percorso può comprendere un briefing per dirigenti o un workshop tecnico con materiali di supporto, su obiettivi e contenuti concordati.',
    'Preparing managers or technical teams to make decisions about AI in your organisation? We can start with their questions and your use cases. An engagement can include a tailored executive briefing or technical workshop with supporting materials, based on agreed objectives and content.',
  ],
].map(([itTitle, enTitle, itBody, enBody]) => (it ? [itTitle, itBody] : [enTitle, enBody]));
---

<BaseLayout
  locale={locale}
  title={it ? 'Consulenza | Federico Cerutti' : 'Advisory | Federico Cerutti'}
  description={
    it
      ? 'Ricerca, consulenza e formazione per aziende ed enti attraverso UniBS.'
      : 'Research, technical consultancy and training for companies through UniBS.'
  }
  alternatePath={it ? '/en/advisory/' : '/it/consulenza/'}
>
  <section class="page-intro">
    <div class="container stack">
      <h1>{it ? 'Ricerca, consulenza e formazione' : 'Research, consultancy and training'}</h1>
      <p class="lede">
        {it
          ? 'Consulenza tecnica e formazione per adottare l’AI senza perdere controllo su conoscenze, rischi e responsabilità.'
          : 'Technical consultancy and training to adopt AI while retaining control over knowledge, risks and responsibilities.'}
      </p>
      <p>
        {it
          ? 'Possiamo iniziare da una domanda concreta con una valutazione mirata, una revisione tecnica o un workshop su misura. Attività e risultati attesi sono definiti nel perimetro concordato.'
          : 'We can start with a defined organisational question through a focused assessment, technical review or tailored workshop. Activities and expected outputs depend on the agreed scope.'}
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container three-col">
      {services.map(([title, body]) => (
        <article class="stack">
          <h2>{title}</h2>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Formazione avanzata in cybersecurity' : 'Advanced cybersecurity education'}</h2>
      <p>
        {it ? 'Dirigo il ' : 'I direct the University of Brescia’s '}
        <a href="https://corsi.unibs.it/it/mascai26">
          {it
            ? 'Master di II livello in Cybersecurity e Compliance aziendale integrata'
            : 'second-level Master’s programme in Cybersecurity and Integrated Corporate Compliance'}
        </a>
        {it ? ' dell’Università degli Studi di Brescia.' : '.'}
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Come funziona un contratto conto terzi' : 'How a university agreement works'}</h2>
      <CompanyIntroduction locale={locale} />
    </div>
  </section>
  <ContactInvitation locale={locale} advisory />
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Informazioni UniBS' : 'UniBS information'}</h2>
      <ul class="plain-links">
        <li>
          <a href={`https://www.unibs.it/${it ? 'it' : 'en'}/enti-aziende/ricerca-commissionata`}>
            {it ? 'Ricerca commissionata' : 'Commissioned research'}
          </a>
        </li>
        <li>
          <a href="https://www.unibs.it/it/ateneo/amministrazione/statuto-e-regolamenti/regolamenti-ricerca">
            {it ? 'Regolamenti per la ricerca' : 'Research regulations (in Italian)'}
          </a>
        </li>
        <li>
          <a href="https://www.unibs.it/it/node/1536">
            {it ? 'Regolamento conto terzi' : 'Regulation for commissioned activities (in Italian)'}
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
