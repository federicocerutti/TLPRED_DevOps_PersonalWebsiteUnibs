---
import AcademicRoles from './AcademicRoles.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyIntroduction from './CompanyIntroduction.astro';
import ContactInvitation from './ContactInvitation.astro';
import type { Locale } from '../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const it = locale === 'it';
const services = it
  ? [
      [
        'Proteggere la conoscenza critica',
        'Individuare quali conoscenze rendono possibile il lavoro dell’organizzazione e come vengono esposte o disperse usando LLM, RAG e agenti. Il lavoro può produrre una mappa delle conoscenze critiche, dei rischi e delle priorità di protezione.',
      ],
      [
        'Valutare AI e rischi cyber',
        'Esaminare affidabilità, incertezza e sicurezza dei sistemi di AI. Confrontare metodi di valutazione, discutere scenari di abuso e definire verifiche e supervisione umana prima dell’adozione. Il risultato è una revisione tecnica con raccomandazioni e priorità.',
      ],
      [
        'Rendere le decisioni ricostruibili',
        'Collegare informazioni, vincoli e responsabilità nelle decisioni su sicurezza e AI. Individuare lacune nei processi e nella documentazione, così che una scelta possa essere spiegata e riesaminata anche quando cambiano persone o strumenti.',
      ],
      [
        'Formare chi decide e chi realizza',
        'Briefing per dirigenti e workshop per gruppi tecnici su rischi dell’AI, conoscenza organizzativa, cybersecurity e decisioni sotto incertezza. Casi e materiali sono adattati alle domande dell’organizzazione.',
      ],
    ]
  : [
      [
        'Protect critical knowledge',
        'Identify the knowledge your organisation depends on and how LLMs, RAG and agents can expose or erode it. The work can produce a map of critical knowledge, associated risks and priorities for protection.',
      ],
      [
        'Assess AI and cyber risks',
        'Examine the reliability, uncertainty and security of AI systems. Compare evaluation methods, explore misuse scenarios and define checks and human oversight before adoption. The output is a technical review with recommendations and priorities.',
      ],
      [
        'Make decisions traceable',
        'Connect information, constraints and responsibilities in security and AI decisions. Identify gaps in processes and documentation so that a choice can be explained and revisited as people and tools change.',
      ],
      [
        'Train decision-makers and technical teams',
        'Executive briefings and technical workshops on AI risks, organisational knowledge, cybersecurity and decisions under uncertainty. Cases and materials are adapted to the organisation’s questions.',
      ],
    ];
---

<BaseLayout
  locale={locale}
  title={it ? 'Consulenza | Federico Cerutti' : 'Advisory | Federico Cerutti'}
  description={
    it
      ? 'Ricerca, consulenza e formazione per aziende ed enti attraverso UniBS.'
      : 'Research, technical consultancy and training for companies through UniBS.'
  }
  alternatePath={it ? '/en/advisory/' : '/it/consulenza/'}
>
  <section class="page-intro">
    <div class="container stack">
      <h1>{it ? 'Ricerca, consulenza e formazione' : 'Research, consultancy and training'}</h1>
      <p class="lede">
        {it
          ? 'Consulenza tecnica e formazione per adottare l’AI senza perdere controllo su conoscenze, rischi e responsabilità.'
          : 'Technical consultancy and training to adopt AI while retaining control over knowledge, risks and responsibilities.'}
      </p>
      <p>
        {it
          ? 'Mi occupo di sicurezza dell’AI, cybersecurity, ragionamento sotto incertezza e collaborazione uomo–AI.'
          : 'My work concerns AI security, cybersecurity, reasoning under uncertainty and human–AI collaboration.'}
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container three-col">
      {services.map(([title, body]) => (
        <article class="stack">
          <h2>{title}</h2>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Come funziona un contratto conto terzi' : 'How a university agreement works'}</h2>
      <CompanyIntroduction locale={locale} />
      <p>
        {it
          ? 'La tua organizzazione affida un incarico all’Università, che mette a disposizione competenze scientifiche e tecniche per il problema concordato. Partiamo da una conversazione: può trattarsi di una valutazione, una relazione tecnica, un’attività di ricerca o un percorso di formazione. Prima di iniziare si definiscono attività, risultati attesi, tempi e corrispettivo nel contratto con l’Ateneo.'
          : 'Your organisation commissions the university to apply scientific and technical expertise to an agreed problem. We start with a conversation: the work might be an assessment, a technical report, a research activity or a training programme. Before work starts, the agreement with the university sets out the activities, expected outputs, timing and fee.'}
      </p>
    </div>
  </section>
  <AcademicRoles locale={locale} />
  <ContactInvitation locale={locale} />
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Informazioni UniBS' : 'UniBS information'}</h2>
      <ul class="plain-links">
        <li>
          <a href={`https://www.unibs.it/${it ? 'it' : 'en'}/enti-aziende/ricerca-commissionata`}>
            {it ? 'Ricerca commissionata' : 'Commissioned research'}
          </a>
        </li>
        <li>
          <a href="https://www.unibs.it/it/ateneo/amministrazione/statuto-e-regolamenti/regolamenti-ricerca">
            {it ? 'Regolamenti per la ricerca' : 'Research regulations (in Italian)'}
          </a>
        </li>
        <li>
          <a href="https://www.unibs.it/it/node/1536">
            {it ? 'Regolamento conto terzi' : 'Regulation for commissioned activities (in Italian)'}
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
