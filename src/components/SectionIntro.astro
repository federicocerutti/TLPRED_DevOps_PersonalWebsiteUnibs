---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  actionHref?: string;
  actionLabel?: string;
}
const { eyebrow, title, intro, actionHref, actionLabel } = Astro.props;
---

<div class="stack" style="margin-bottom: 2.5rem; max-width: 720px;">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h1>
    {title}
  </h1>
  <p class="muted" style="font-size: 1.1rem; margin: 0;">
    {intro}
  </p>
  {actionHref && actionLabel && (
    <div>
      <a class="button" href={actionHref}>
        {actionLabel}
      </a>
    </div>
  )}
</div>
