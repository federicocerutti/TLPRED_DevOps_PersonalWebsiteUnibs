---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyIntroduction from './CompanyIntroduction.astro';
import ContentCard from './ContentCard.astro';
import { getProfile } from '../lib/content-data';
import { bio as enBio } from '../lib/bio-en';
import { bio as itBio } from '../lib/bio-it';
import { getLocalizedEvents } from '../lib/events-data';
import { featuredCollaborations, organizationsById, worksById } from '../lib/portfolio';
import { sourceUrl } from '../lib/research';
import type { Locale } from '../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const it = locale === 'it';
const profile = getProfile(locale);
const network = it ? '/it/rete-di-ricerca/' : '/en/research-network/';
const projects = it ? '/progetti/' : '/en/projects/';
const events = getLocalizedEvents(locale).slice(0, 3);
---

<BaseLayout
  locale={locale}
  title="Federico Cerutti | AI, cybersecurity"
  description={profile.seo.description}
  alternatePath={it ? '/' : '/it/'}
>
  <section class="home-introduction">
    <div class="container home-profile">
      <div class="stack">
        <h1 class="sr-only">Federico Cerutti</h1>
        <div class="biography" set:html={`<p>${it ? itBio : enBio}</p>`} />
        <CompanyIntroduction locale={locale} />
        <p>
          <a href={it ? '/it/consulenza/' : '/en/advisory/'}>
            {it ? 'Ricerca, consulenza e formazione' : 'Research, consultancy and training'}
          </a>{' '}
          · <a href="mailto:federico.cerutti@unibs.it">federico.cerutti@unibs.it</a>
        </p>
      </div>
      <img
        class="home-portrait"
        src={profile.portrait}
        alt={profile.portraitAlt}
        width="360"
        height="450"
        fetchpriority="high"
      />
    </div>
  </section>
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Collaborazioni' : 'Collaborations'}</h2>
      <div class="three-col featured-collaborations">
        {featuredCollaborations.map((f) => (
          <article class="stack">
            <h3>
              <a href={`${network}#${f.organizationId}`}>{f.label}</a>
            </h3>
            <p class="small muted">{organizationsById.get(f.organizationId)?.name}</p>
            <ul class="plain-links">
              {f.workIds.map((id) => {
                const w = worksById.get(id)!;
                return (
                  <li>
                    <a href={sourceUrl(w)}>{w.title}</a> <span class="muted">({w.year})</span>
                  </li>
                );
              })}
            </ul>
          </article>
        ))}
      </div>
      <p>
        <a href={network}>{it ? 'Tutte le collaborazioni' : 'All collaborations'}</a>
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Per chi vuole fare ricerca' : 'For prospective students'}</h2>
      <p>
        {it
          ? 'Se ti interessa una tesi o un percorso di ricerca su AI, cybersecurity e ragionamento sotto incertezza, dai un’occhiata ai progetti in corso e scrivimi per discuterne.'
          : 'If you are interested in a thesis or research on AI, cybersecurity and reasoning under uncertainty, take a look at my current projects and email me to discuss possible topics.'}
      </p>
      <p>
        <a href={`${projects}true/`}>TRUE</a> · <a href={`${projects}ns-cep/`}>NS-CEP</a> ·{' '}
        <a href={it ? '/teaching/' : '/en/teaching/'}>{it ? 'Didattica' : 'Teaching'}</a> ·{' '}
        <a href="mailto:federico.cerutti@unibs.it">federico.cerutti@unibs.it</a>
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Attività recenti' : 'Recent activity'}</h2>
      <div class="three-col">
        {events.map((e) => (
          <ContentCard
            title={e.title}
            href={`${it ? '/eventi/' : '/en/events/'}${e.pathSlug}/`}
            summary={e.summary}
            image={e.image}
            imageAttribution={e.imageAttribution}
            meta={e.meta}
            plain
          />
        ))}
      </div>
      <p>
        <a href={it ? '/eventi/' : '/en/events/'}>{it ? 'Tutti gli eventi' : 'All events'}</a>
      </p>
    </div>
  </section>
</BaseLayout>
