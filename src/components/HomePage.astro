---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from './ContentCard.astro';
import { getProfile } from '../lib/content-data';
import { getLocalizedEvents } from '../lib/events-data';
import {
  featuredCollaborations,
  collaborationStatistics,
  currentCollaborationFocus,
  organizationsById,
  worksById,
  collaborationCopy,
  collaborationPath,
} from '../lib/portfolio';
import { sourceUrl } from '../lib/research';
import { site, type Locale } from '../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const it = locale === 'it';
const profile = getProfile(locale);
const network = it ? '/it/rete-di-ricerca/' : '/en/research-network/';
const projects = it ? '/progetti/' : '/en/projects/';
const events = getLocalizedEvents(locale).slice(0, 3);
const networkStatistics = [
  { value: collaborationStatistics.companies, label: it ? 'aziende' : 'companies' },
  { value: collaborationStatistics.institutions, label: it ? 'istituzioni e centri di ricerca' : 'institutions and research centres' },
  { value: collaborationStatistics.universities, label: it ? 'università' : 'universities' },
];
---

<BaseLayout
  locale={locale}
  title="Federico Cerutti | AI, cybersecurity"
  description={profile.seo.description}
  alternatePath={it ? '/' : '/it/'}
>
  <section class="home-introduction">
    <div class="container home-profile">
      <div class="stack">
        <h1 class="home-opening">
          {it
            ? 'Adottare l’AI. Proteggere ciò che la tua organizzazione sa.'
            : 'Adopt AI. Protect what your organisation knows.'}
        </h1>
        <p class="biography">
          {it
            ? 'Aiuto aziende ed enti ad adottare l’AI con documenti interni, valutare sistemi e fornitori e definire quando servono verifiche e supervisione umana.'
            : 'I help companies and institutions adopt AI using internal documents, assess systems and suppliers, and define where checks and human oversight are needed.'}
        </p>
        <p>
          {it
            ? 'Sono Federico Cerutti, Professore Ordinario all’Università degli Studi di Brescia. Dirigo il nodo di Brescia del CINI National Cybersecurity Lab e ho incarichi accademici a Imperial, Southampton e Cardiff. Porto questa esperienza nella consulenza tecnica e nella formazione per le organizzazioni.'
            : 'I’m Federico Cerutti, Full Professor at the University of Brescia. As director of the Brescia node of the CINI National Cybersecurity Lab, with academic appointments at Imperial, Southampton and Cardiff, I bring AI and cybersecurity research into technical consultancy and training.'}
        </p>
        <p>
          <a href={it ? '/it/consulenza/' : '/en/advisory/'}>
            {it ? 'Scopri consulenza e formazione' : 'Explore consultancy and training'}
          </a>{' '}
        </p>
        <p class="home-contact-links">
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
          <a href={site.contactPhoneUrl}>{site.contactPhone}</a>
          <a href={site.linkedinUrl}>LinkedIn</a>
          <a href="/federico-cerutti.vcf" download="federico-cerutti.vcf">
            {it ? 'Salva contatto (vCard)' : 'Save contact (vCard)'}
          </a>
        </p>
      </div>
      <img
        class="home-portrait"
        src={profile.portrait}
        alt={profile.portraitAlt}
        width="360"
        height="450"
        fetchpriority="high"
      />
    </div>
  </section>
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Collaborazioni' : 'Collaborations'}</h2>
      <p class="collaboration-section-intro">
        {it
          ? 'Questi numeri descrivono relazioni di ricerca attuali e passate con aziende, istituzioni e università su AI, cybersecurity e supporto alle decisioni.'
          : 'These figures describe current and past research relationships with companies, institutions and universities on AI, cybersecurity and decision support.'}
      </p>
      <div class="research-network-summary stack">
        <dl class="network-statistics">
          {networkStatistics.map(stat => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
        <p><a href={network}>{it ? 'Esplora tutte le collaborazioni' : 'Explore all collaborations'} →</a></p>
      </div>
      <h2 class="recent-collaborations-heading">{it ? 'Collaborazioni recenti' : 'Recent collaborations'}</h2>
      <div class="three-col featured-collaborations">
        {featuredCollaborations.map((f) => (
          <article class="stack">
            <h3>
              <a href={collaborationPath(f.organizationId, locale)}>{f.label}</a>
            </h3>
            <p class="small muted">
              {collaborationCopy(organizationsById.get(f.organizationId)!, locale).identity}
            </p>
            <p>{currentCollaborationFocus[f.organizationId][locale]}</p>
            <p class="featured-collaboration-links">
              <a href={collaborationPath(f.organizationId, locale)}>
                {it ? 'Scopri la collaborazione' : 'Explore the collaboration'}
              </a>
              {(() => {
                const w = worksById.get(f.workIds[0])!;
                const url = sourceUrl(w);
                return url && <a href={url} title={w.title}>
                  {it ? 'Articolo recente' : 'Recent paper'} ({w.year})
                </a>;
              })()}
            </p>
          </article>
        ))}
      </div>

    </div>
  </section>
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Per gli studenti' : 'For students'}</h2>
      <p>
        {it
          ? 'Se ti interessa una tesi o un percorso di ricerca su AI, cybersecurity e ragionamento sotto incertezza, dai un’occhiata ai progetti in corso e scrivimi per discuterne.'
          : 'If you are interested in a thesis or research on AI, cybersecurity and reasoning under uncertainty, take a look at my current projects and email me to discuss possible topics.'}
      </p>
      <p>
        <a href={`${projects}true/`}>TRUE</a> · <a href={`${projects}ns-cep/`}>NS-CEP</a> ·{' '}
        <a href={it ? '/teaching/' : '/en/teaching/'}>{it ? 'Didattica' : 'Teaching'}</a> ·{' '}
        <a href="mailto:federico.cerutti@unibs.it">federico.cerutti@unibs.it</a>
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container stack">
      <h2>{it ? 'Attività recenti' : 'Recent activity'}</h2>
      <div class="three-col">
        {events.map((e) => (
          <ContentCard
            title={e.title}
            href={`${it ? '/eventi/' : '/en/events/'}${e.pathSlug}/`}
            summary={e.summary}
            image={e.image}
            imageStyle={e.imageFit === 'contain' ? 'height: 220px; width: 100%; object-fit: contain; background: #fff;' : undefined}
            imageAttribution={e.imageAttribution}
            meta={e.meta}
            plain
          />
        ))}
      </div>
      <p>
        <a href={it ? '/eventi/' : '/en/events/'}>{it ? 'Tutti gli eventi' : 'All events'}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.5rem;
  }
</style>
