---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactInvitation from './ContactInvitation.astro';
import { getProfile, getLocalizedCollection } from '../lib/content-data';
import { getLocalizedEvents } from '../lib/events-data';
import { research, sourceUrl } from '../lib/research';
import type { Locale } from '../lib/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const it = locale === 'it';
const profile = getProfile(locale);
const advisory = it ? '/it/consulenza/' : '/en/advisory/';
const archive = it ? '/it/ricerca/' : '/en/research/';
const network = it ? '/it/rete-di-ricerca/' : '/en/research-network/';
const themes = it
  ? [
      [
        '01',
        'Quanto è affidabile questo sistema di AI?',
        'Valutare incertezza, interpretabilità e limiti delle evidenze prima di affidarsi a una raccomandazione.',
        'Risk-aware classification via uncertainty quantification',
      ],
      [
        '02',
        'Quali rischi di sicurezza stiamo trascurando?',
        'Esaminare sicurezza dell’AI e cyber threat intelligence, collegando dati tecnici e ragionamento esplicito.',
        'Enabling Transparent Cyber Threat Intelligence',
      ],
      [
        '03',
        'Come sostenere una decisione difficile?',
        'Usare argomentazione e collaborazione uomo–AI quando fonti, obiettivi o conclusioni sono in conflitto.',
        'Human-machine collaboration in intelligence analysis',
      ],
    ]
  : [
      [
        '01',
        'How reliable is this AI system?',
        'Examine uncertainty, interpretability and the limits of the evidence before relying on a recommendation.',
        'Risk-aware classification via uncertainty quantification',
      ],
      [
        '02',
        'Which security risks are we overlooking?',
        'Examine AI security and cyber threat intelligence, connecting technical data with explicit reasoning.',
        'Enabling Transparent Cyber Threat Intelligence',
      ],
      [
        '03',
        'How can we support a difficult decision?',
        'Use argumentation and human–AI collaboration when sources, objectives or conclusions conflict.',
        'Human-machine collaboration in intelligence analysis',
      ],
    ];
const evidence = it
  ? [
      [
        'IBM Research',
        'Pubblicazioni con ricercatori di T. J. Watson e Hursley: sedi e periodi sono documentati separatamente.',
        'org:ibm-t-j-watson-research-center',
      ],
      [
        'NEC Laboratories Europe',
        'Profilo professionale verificato di Lorenzo Nodari; distinto dalle affiliazioni delle pubblicazioni precedenti.',
        'org:nec-laboratories-europe-verified-current',
      ],
      [
        'Airbus',
        'Dimostrazione DAIS del 2017 con Alistair Nottle e Santiago Quintana; evidenza distinta dalle pubblicazioni indicizzate.',
        'org:airbus-dais-joint-demonstration',
      ],
    ]
  : [
      [
        'IBM Research',
        'Publications with researchers at T. J. Watson and Hursley, with sites and observed periods documented separately.',
        'org:ibm-t-j-watson-research-center',
      ],
      [
        'NEC Laboratories Europe',
        'Lorenzo Nodari’s verified professional profile, distinguished from affiliations on earlier joint publications.',
        'org:nec-laboratories-europe-verified-current',
      ],
      [
        'Airbus',
        'A 2017 DAIS demonstration with Alistair Nottle and Santiago Quintana; separate evidence from indexed publications.',
        'org:airbus-dais-joint-demonstration',
      ],
    ];
const selected = themes
  .map((t) => research.works.find((w) => w.title.startsWith(t[3]))!)
  .filter(Boolean);
const projects = getLocalizedCollection('projects', locale).slice(0, 3);
const events = getLocalizedEvents(locale)
  .filter((e) => e.year <= String(new Date().getFullYear()))
  .slice(0, 3);
---

<BaseLayout
  locale={locale}
  title={
    it
      ? 'Federico Cerutti | Ricerca e consulenza su AI e cybersecurity'
      : 'Federico Cerutti | AI & cybersecurity research and advisory'
  }
  description={
    it
      ? 'Ricerca e consulenza tecnica indipendente su sicurezza dell’AI, incertezza e decisioni uomo–AI.'
      : 'Research and independent technical advisory on AI security, uncertainty and human–AI decision-making.'
  }
  alternatePath={it ? '/' : '/it/'}
>
  <section class="home-hero">
    <div class="container">
      <div class="hero-label">
        <span class="eyebrow">
          {it
            ? 'Federico Cerutti / Ricerca e consulenza'
            : 'Federico Cerutti / Research & advisory'}
        </span>
        <span>
          {it
            ? 'Brescia, Italia · Collaborazioni internazionali'
            : 'Brescia, Italy · International research connections'}
        </span>
      </div>
      <div class="home-hero-grid">
        <div>
          <h1>
            {it
              ? 'AI, sicurezza e decisioni sotto incertezza.'
              : 'AI, security & decisions under uncertainty.'}
          </h1>
          <p class="lede">
            {it
              ? 'Professore Ordinario all’Università degli Studi di Brescia. Ricerca e consulenza tecnica indipendente per comprendere l’affidabilità dei sistemi di AI e le evidenze alla base delle decisioni.'
              : 'Full Professor at the University of Brescia. Research and independent technical advisory on the reliability of AI systems and the evidence behind decisions.'}
          </p>
          <div class="actions">
            <a
              class="button"
              data-analytics-event="advisory-contact"
              href="mailto:federico.cerutti@unibs.it"
            >
              {it ? 'Discutiamo una consulenza' : 'Discuss an advisory engagement'}{' '}
              <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href={advisory}>
              {it ? 'Scopri la consulenza' : 'Explore advisory'} →
            </a>
          </div>
        </div>
        <figure class="portrait-block">
          <img
            src={profile.portrait}
            alt={profile.portraitAlt}
            width="290"
            height="363"
            fetchpriority="high"
          />
          <figcaption>
            Federico Cerutti
            <br />
            {it ? 'Professore Ordinario' : 'Full Professor'}
            <br />
            Università degli Studi di Brescia
          </figcaption>
        </figure>
      </div>
      <div class="hero-footnote">
        <span>AI security / Cybersecurity</span>
        <span>{it ? 'Ragionamento sotto incertezza' : 'Reasoning under uncertainty'}</span>
        <span>
          {it ? 'Argomentazione / Decisioni uomo–AI' : 'Argumentation / Human–AI decision-making'}
        </span>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">
            {it ? 'Dalle domande alla ricerca' : 'From questions to research'}
          </span>
          <h2>
            {it
              ? 'Problemi che meritano un esame indipendente.'
              : 'Questions worth an independent look.'}
          </h2>
        </div>
        <p class="muted">
          {it
            ? 'Per responsabili tecnici, dirigenti e partner di ricerca che devono valutare sistemi, rischi ed evidenze.'
            : 'For technical leaders, executives and research partners evaluating systems, risks and evidence.'}
        </p>
      </div>
      <div class="three-col">
        {themes.map((t) => (
          <article class="card question-card">
            <span class="number">{t[0]} /</span>
            <h3>{t[1]}</h3>
            <p class="muted">{t[2]}</p>
            <a class="text-link" href={`${archive}?q=${encodeURIComponent(t[3])}`}>
              {it ? 'Ricerca di riferimento' : 'Supporting research'} →
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section advisory-band">
    <div class="container two-col">
      <div class="stack">
        <span class="eyebrow">{it ? 'Lavorare insieme' : 'Working together'}</span>
        <h2>
          {it
            ? 'Un punto di vista tecnico, fondato sulla ricerca.'
            : 'A technical perspective, grounded in research.'}
        </h2>
        <p class="muted">
          {it
            ? 'Il punto di partenza è la domanda da chiarire: quale rischio valutare, quale evidenza manca e quale decisione deve essere sostenuta.'
            : 'The starting point is the question to clarify: which risk needs examining, what evidence is missing and which decision needs support.'}
        </p>
        <a class="text-link" href={advisory}>
          {it ? 'Come si struttura una consulenza' : 'How an engagement can work'} →
        </a>
      </div>
      <ul class="service-list">
        <li>
          <h3>{it ? 'Consulenza tecnica indipendente' : 'Independent technical advisory'}</h3>
          <p>
            {it
              ? 'Valutazioni critiche, revisioni tecniche e raccomandazioni su AI, sicurezza e affidabilità.'
              : 'Independent assessments, technical reviews and recommendations on AI, security and reliability.'}
          </p>
        </li>
        <li>
          <h3>{it ? 'Formazione e strategia' : 'Training & strategy'}</h3>
          <p>
            {it
              ? 'Briefing per dirigenti e workshop specialistici per comprendere metodi, limiti e implicazioni dell’AI.'
              : 'Executive briefings and specialist workshops on AI methods, limitations and organisational implications.'}
          </p>
        </li>
      </ul>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">{it ? 'Evidenze e connessioni' : 'Evidence & connections'}</span>
          <h2>
            {it ? 'La ricerca attraversa le organizzazioni.' : 'Research across organisations.'}
          </h2>
        </div>
        <p class="muted">
          {it
            ? 'Pubblicazioni, ricercatori e fonti professionali. Queste connessioni non costituiscono un elenco di clienti o endorsement.'
            : 'Publications, researchers and professional sources. These connections are not a client list or endorsements.'}
        </p>
      </div>
      {evidence.map((e) => (
        <article class="evidence-row">
          <h3>{e[0]}</h3>
          <p>{e[1]}</p>
          <a class="text-link" href={`${network}?selected=${e[2]}`}>
            {it ? 'Esamina le fonti' : 'Inspect evidence'} ↗
          </a>
        </article>
      ))}
      <div class="actions" style="margin-top:2rem">
        <a class="button secondary" href={network}>
          {it ? 'Esplora la rete di ricerca' : 'Explore the research network'} →
        </a>
        <a class="text-link" href={`${network}?sector=Industry`}>
          {it ? 'Connessioni con l’industria' : 'Industry connections'} →
        </a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">{it ? 'Pubblicazioni selezionate' : 'Selected publications'}</span>
          <h2>{it ? 'Metodi, evidenze, applicazioni.' : 'Methods, evidence, applications.'}</h2>
        </div>
        <a class="text-link" href={archive}>
          {it ? 'Archivio delle pubblicazioni' : 'Publication archive'} →
        </a>
      </div>
      <ol class="publications">
        {selected.map((w) => (
          <li class="publication">
            <div class="meta">
              <span>{w.year}</span>
              <span>{w.venue}</span>
            </div>
            <h3>
              <a href={sourceUrl(w)} data-analytics-event="publication-link">
                {w.title}
              </a>
            </h3>
            <span class="badge">{w.recordStatus.startsWith('Scopus') ? 'Scopus' : 'DBLP'}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">{it ? 'Progetti di ricerca' : 'Research projects'}</span>
          <h2>{it ? 'Dalle domande ai programmi di ricerca.' : 'Questions pursued in depth.'}</h2>
        </div>
        <a class="text-link" href={it ? '/progetti/' : '/en/projects/'}>
          {it ? 'Tutti i progetti' : 'All projects'} →
        </a>
      </div>
      <div class="three-col">
        {projects.map((p) => (
          <article class="card stack">
            <div class="meta">
              {p.startDate.slice(0, 4)} — {p.endDate?.slice(0, 4) ?? (it ? 'in corso' : 'ongoing')}
            </div>
            <h3>
              <a
                data-analytics-event="project-link"
                href={`${it ? '/progetti/' : '/en/projects/'}${p.pathSlug}/`}
              >
                {p.title}
              </a>
            </h3>
            <p class="muted">{p.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">{it ? 'Attività recenti' : 'Recent activity'}</span>
          <h2>{it ? 'Interventi e confronto pubblico.' : 'Talks & public discussion.'}</h2>
        </div>
        <a class="text-link" href={it ? '/eventi/' : '/en/events/'}>
          {it ? 'Archivio eventi' : 'Events archive'} →
        </a>
      </div>
      <div class="three-col">
        {events.map((e) => (
          <article class="card stack">
            <div class="meta">{e.meta[0]}</div>
            <h3>
              <a href={`${it ? '/eventi/' : '/en/events/'}${e.pathSlug}/`}>{e.title}</a>
            </h3>
            <p class="muted">{e.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <ContactInvitation locale={locale} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Federico Cerutti',
      url: 'https://federico-cerutti.unibs.it/',
      jobTitle: 'Full Professor',
      affiliation: { '@type': 'CollegeOrUniversity', name: 'University of Brescia' },
      knowsAbout: [
        'AI security',
        'Cybersecurity',
        'Argumentation',
        'Reasoning under uncertainty',
        'Human–AI decision-making',
      ],
    }).replace(/</g, '\\u003c')}
  />
</BaseLayout>
