---
import '../styles/editorial.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import Analytics from '../components/Analytics.astro';
import { navByLocale, secondaryNavByLocale, site, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  alternatePath?: string;
}

const {
  locale,
  title,
  description,
  image = site.socialImage,
  imageAlt = title,
  alternatePath,
} = Astro.props;
const nav = navByLocale[locale];
const currentUrl = new URL(
  Astro.url.pathname === '/en/'
    ? '/'
    : Astro.url.pathname === '/ricerca/'
      ? '/it/ricerca/'
      : Astro.url.pathname,
  Astro.site ?? site.baseUrl,
).toString();
const alternateUrl = alternatePath
  ? new URL(alternatePath, Astro.site ?? site.baseUrl).toString()
  : null;
const currentPath = Astro.url.pathname;
const requestedImage = image || site.socialImage;
const socialImagePath = requestedImage.toLowerCase().endsWith('.svg')
  ? site.socialImage
  : requestedImage;
const socialImageUrl = new URL(socialImagePath, Astro.site ?? site.baseUrl).toString();
const socialLocale = locale === 'it' ? 'it_IT' : 'en_GB';
const alternateSocialLocale = locale === 'it' ? 'en_GB' : 'it_IT';
const themeToggleTitle = locale === 'it' ? 'Cambia tema' : 'Toggle theme';
const lightThemeLabel = locale === 'it' ? 'Chiaro' : 'Light';
const darkThemeLabel = locale === 'it' ? 'Scuro' : 'Dark';
const themeSystemHint =
  locale === 'it'
    ? 'Segue il tema del sistema finché non lo cambi.'
    : 'Follows the system theme until you change it.';

const footerAffiliations =
  locale === 'it'
    ? [
        { label: site.contactRole.it, href: site.addressUrl },
        {
          label: "Director of the Brescia's Node of the CINI National Cybersecurity Lab",
          href: 'https://cyberseclab.unibs.it/',
        },
        { label: 'Visiting Senior Lecturer, Cardiff University' },
        { label: 'Visiting Fellow, University of Southampton' },
        { label: 'Visiting Professor, Imperial College London' },
      ]
    : [
        { label: site.contactRole.en, href: site.addressUrl },
        {
          label: "Director of the Brescia's Node of the CINI National Cybersecurity Lab",
          href: 'https://cyberseclab.unibs.it/',
        },
        { label: 'Visiting Senior Lecturer, Cardiff University' },
        { label: 'Visiting Fellow, University of Southampton' },
        { label: 'Visiting Professor, Imperial College London' },
      ];

function isExternalUrl(href: string) {
  return href.startsWith('http://') || href.startsWith('https://');
}

function isActivePath(href: string) {
  if (isExternalUrl(href)) return false;
  return currentPath === href || currentPath.startsWith(href);
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4ef" />
    <link rel="canonical" href={currentUrl} />
    <link rel="alternate" hreflang={locale} href={currentUrl} />
    {alternateUrl && (
      <link rel="alternate" hreflang={locale === 'it' ? 'en' : 'it'} href={alternateUrl} />
    )}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={socialLocale} />
    <meta property="og:locale:alternate" content={alternateSocialLocale} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline>
      (() => {
        let stored;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme =
          stored === 'light' || stored === 'dark' ? stored : systemDark ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {locale === 'it' ? 'Vai al contenuto' : 'Skip to content'}
    </a>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand" href={locale === 'it' ? '/it/' : '/'}>
          <strong>Prof. Federico Cerutti</strong>
          <span>
            {locale === 'it'
              ? 'Ricerca · Consulenza indipendente'
              : 'Research · Independent advisory'}
          </span>
        </a>
        <div class="header-nav-wrap">
          <nav
            class="primary-nav"
            aria-label={locale === 'it' ? 'Navigazione principale' : 'Primary navigation'}
          >
            {nav.map((item) => (
              <a
                href={item.href}
                target={isExternalUrl(item.href) ? '_blank' : undefined}
                rel={isExternalUrl(item.href) ? 'noreferrer' : undefined}
                aria-current={isActivePath(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
        <div
          class="header-utilities"
          aria-label={locale === 'it' ? 'Controlli interfaccia' : 'Interface controls'}
        >
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            data-light-label={lightThemeLabel}
            data-dark-label={darkThemeLabel}
            data-toggle-title={themeToggleTitle}
            data-system-hint={themeSystemHint}
            title={themeSystemHint}
            aria-label={themeToggleTitle}
          >
            <svg
              data-theme-icon="dark"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
            <svg
              data-theme-icon="light"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2.2M12 19.8V22M4.22 4.22l1.56 1.56M18.22 18.22l1.56 1.56M2 12h2.2M19.8 12H22M4.22 19.78l1.56-1.56M18.22 5.78l1.56-1.56" />
            </svg>
          </button>
          <a
            class="lang-switch"
            href={alternatePath ?? (locale === 'it' ? '/' : '/it/')}
            aria-label={locale === 'it' ? 'Switch to English' : 'Passa a Italiano'}
          >
            {locale === 'it' ? 'EN' : 'IT'}
          </a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer-main">
        <div class="footer-panel footer-brand stack">
          <strong>{site.name}</strong>
          <div class="footer-affiliations">
            {footerAffiliations.map((item) => (
              <p class="footer-affiliation">
                {item.href ? (
                  <a href={item.href} target="_blank" rel="noopener noreferrer">
                    {item.label}
                  </a>
                ) : (
                  item.label
                )}
              </p>
            ))}
          </div>
          <div class="footer-meta">
            <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
          </div>
        </div>
        <div class="footer-panel footer-panel--nav">
          <span class="footer-label">{locale === 'it' ? 'Esplora' : 'Explore'}</span>
          <nav
            class="footer-nav"
            aria-label={locale === 'it' ? 'Navigazione footer' : 'Footer navigation'}
          >
            {[...nav, ...secondaryNavByLocale[locale]].map((item) => (
              <a
                href={item.href}
                target={isExternalUrl(item.href) ? '_blank' : undefined}
                rel={isExternalUrl(item.href) ? 'noreferrer' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>
          {locale === 'it'
            ? 'Le preferenze di tema sono salvate nel browser. Le statistiche facoltative restano disattivate senza consenso e approvazione.'
            : 'Theme preferences are stored in your browser. Optional analytics stays off without consent and approval.'}
        </p>
        <span>
          {locale === 'it' ? (
            <a
              href="https://www.unibs.it/it/privacy-policy-university-portals"
              target="_blank"
              rel="noopener noreferrer"
            >
              Privacy policy dell’Università degli Studi di Brescia
            </a>
          ) : (
            <a
              href="https://www.unibs.it/it/privacy-policy-university-portals"
              target="_blank"
              rel="noopener noreferrer"
            >
              University of Brescia privacy policy
            </a>
          )}
        </span>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.querySelector('[data-theme-toggle]');
        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (!button) return;

        const labels = {
          light: button.dataset.lightLabel || 'Light',
          dark: button.dataset.darkLabel || 'Dark',
        };
        const toggleTitle = button.dataset.toggleTitle || 'Toggle theme';
        const systemHint = button.dataset.systemHint || '';

        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          if (themeColor) {
            themeColor.setAttribute('content', theme === 'dark' ? '#151d1a' : '#f5f4ef');
          }
          button.setAttribute(
            'title',
            `${toggleTitle}: ${labels[theme]}${systemHint ? `. ${systemHint}` : ''}`,
          );
          button.setAttribute('aria-label', `${toggleTitle}: ${labels[theme]}`);
        };

        applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');

        button.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem('theme', next);
          } catch {}
          applyTheme(next);
        });
      })();
    </script>
    <Analytics locale={locale} />
  </body>
</html>
