---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import PortfolioList from '../../components/PortfolioList.astro';
import { getLocalizedCollection } from '../../lib/content-data';
import { getProjectActiveYears } from '../../lib/site';

const locale = 'it';
const items = getLocalizedCollection('projects', locale).map((entry) => ({
  title: entry.title,
  href: `/progetti/${entry.pathSlug}/`,
  summary: entry.summary,
  kind: 'Progetto',
  status: entry.status,
  image: entry.image,
  imageAttribution: entry.imageAttribution,
  meta: [entry.funder, entry.status],
  tags: entry.tags,
  people: entry.people,
  years: getProjectActiveYears(entry.startDate, entry.endDate),
}));
---

<BaseLayout
  locale={locale}
  title="Progetti | Federico Cerutti"
  description="Progetti selezionati su cybersecurity, AI, causal reasoning e decision support."
  image="/images/sourced/projects/project-true.jpg"
  alternatePath="/en/projects/"
>
  <section class="section">
    <div class="container">
      <SectionIntro title="Progetti selezionati" />
    </div>
  </section>
  <section class="section">
    <div class="container">
      {['running', 'finished'].map((status) => (
        <section class="stack project-group">
          <h2>{status === 'running' ? 'Progetti in corso' : 'Progetti conclusi'}</h2>
          <PortfolioList
            items={items.filter((item) =>
              status === 'running'
                ? ['running', 'in corso'].includes(item.status)
                : !['running', 'in corso'].includes(item.status),
            )}
          />
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
