---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionIntro from '../../../components/SectionIntro.astro';
import PortfolioList from '../../../components/PortfolioList.astro';
import { getLocalizedEvents } from '../../../lib/events-data';

const locale = 'en';
const items = getLocalizedEvents(locale).map((entry) => ({
  title: entry.title,
  href: `/en/events/${entry.pathSlug}/`,
  summary: entry.summary,
  kind: entry.typeLabel,
  image: entry.image,
  imageStyle: entry.imageFit === 'contain' ? 'height: 220px; width: 100%; object-fit: contain; background: #fff;' : undefined,
  imageAttribution: entry.imageAttribution,
  meta: entry.meta,
  tags: entry.sidebarItems.slice(1),
  people: entry.sidebarItems.filter(
    (item) =>
      item.includes('Federico') ||
      item.includes('Giorgio') ||
      item.includes('Francesco') ||
      item.includes('Renato'),
  ),
  years: entry.year ? [entry.year] : [],
}));
---

<BaseLayout
  locale={locale}
  title="Events | Federico Cerutti"
  description="Conference talks, research tutorials, invited keynotes, roundtables and public events featuring Federico Cerutti."
  image="/images/sourced/events/cyber-security-arena-2025.jpg"
  alternatePath="/eventi/"
>
  <section class="section">
    <div class="container">
      <SectionIntro title="Events" intro="" />
    </div>
  </section>
  <section class="section">
    <div class="container">
      <PortfolioList items={items} />
    </div>
  </section>
</BaseLayout>
