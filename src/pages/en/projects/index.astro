---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionIntro from '../../../components/SectionIntro.astro';
import PortfolioList from '../../../components/PortfolioList.astro';
import { getLocalizedCollection } from '../../../lib/content-data';
import { getProjectActiveYears } from '../../../lib/site';

const locale = 'en';
const items = getLocalizedCollection('projects', locale).map((entry) => ({
  title: entry.title,
  href: `/en/projects/${entry.pathSlug}/`,
  summary: entry.summary,
  kind: 'Project',
  status: entry.status,
  image: entry.image,
  imageAttribution: entry.imageAttribution,
  meta: [entry.funder, entry.status],
  tags: entry.tags,
  people: entry.people,
  years: getProjectActiveYears(entry.startDate, entry.endDate),
}));
---

<BaseLayout
  locale={locale}
  title="Projects | Federico Cerutti"
  description="Selected projects on cybersecurity, AI, causal reasoning, and decision support."
  image="/images/sourced/projects/project-true.jpg"
  alternatePath="/progetti/"
>
  <section class="section">
    <div class="container">
      <SectionIntro title="Selected projects" />
    </div>
  </section>
  <section class="section">
    <div class="container">
      {['running', 'finished'].map((status) => (
        <section class="stack project-group">
          <h2>{status === 'running' ? 'Current projects' : 'Completed projects'}</h2>
          <PortfolioList
            items={items.filter((item) =>
              status === 'running'
                ? ['running', 'in corso'].includes(item.status)
                : !['running', 'in corso'].includes(item.status),
            )}
          />
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
